{
  "name": "changed-file",
  "repo": "repo",
  "operations": [
    {
      "id": "graph-after-change",
      "kind": "rest",
      "method": "GET",
      "route": "/api/graph",
      "capture": "json_body_status",
      "normalizers": ["fixture_root_path"],
      "setup": [
        {"id": "rename-symbol", "kind": "fs", "fs_op": "replace", "path": "hello.go", "find": "func Add(", "replace": "func AddTwo("},
        {"id": "reparse", "kind": "cli", "command": "parse"}
      ]
    }
  ]
}
