      "kind": "cli",
      "command": "memory_add_no_title",
      "capture": "stdout_stderr_exit",
      "normalizers": ["line_endings", "fixture_root_path"]
    },
    {
      "id": "memory-rm-absent",
      "kind": "cli",
      "command": "memory_rm_absent",
      "capture": "stdout_stderr_exit",
      "normalizers": ["line_endings", "fixture_root_path"]
    }
  ]
}
