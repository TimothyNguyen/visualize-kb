{
  "name": "malformed",
  "repo": "repo",
  "operations": [
    {
      "id": "parse-exit",
      "kind": "cli",
      "command": "parse",
      "capture": "stdout_exit",
      "normalizers": ["line_endings", "fixture_root_path"]
    },
    {
      "id": "graph",
      "kind": "rest",
      "method": "GET",
      "route": "/api/graph",
      "capture": "json_body_status",
      "normalizers": ["fixture_root_path"]
    },
    {
      "id": "stats",
      "kind": "rest",
      "method": "GET",
      "route": "/api/stats",
      "capture": "json_body_status",
      "normalizers": ["fixture_root_path"]
    }
  ]
}
