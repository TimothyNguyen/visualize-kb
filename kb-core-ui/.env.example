# Copy to .env next to docker-compose.yml. Every value here is server-only:
# the browser talks to the kb-core-ui backend and never to FalkorDB or a
# provider API, so none of these keys belong in a Vite (VITE_*) variable.
#
# The defaults in docker-compose.yml already run the stack in mocked mode.
# Leave this file empty unless you want a real provider or a secured FalkorDB.

# --- FalkorDB (optional; the compose service needs no credentials) ---
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=
# FALKORDB_SSL=false

# --- Optional real provider ---
# Mocked mode is "fake"/"fake". Switching these to a hosted provider sends
# workspace text to that provider; set the provider's own key variable too.
# RAG_LLM_PROVIDER=openai
# RAG_LLM_MODEL=gpt-4o-mini
# RAG_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY=

# --- Limits ---
# RAG_MAX_CONTEXT=8000
